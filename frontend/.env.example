# 프론트엔드 로컬 개발용 환경 설정 예제
# 사용법: 이 파일을 frontend/.env.development.local 로 복사한 뒤 값 확인
#   cp .env.example .env.development.local
# .env.development.local 은 gitignore 대상이며 Git에 커밋하지 않는다.

NEXT_PUBLIC_API_URL=https://localhost.example.com:8080

# 토스페이먼츠 클라이언트 키 (결제위젯용, 프론트 번들에 그대로 노출되는 값이라 시크릿 키와 다름)
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 카카오맵 JS SDK 앱 키
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
