# ============================================================
# lastmission 로컬 개발용 환경 설정 예제
# 사용법: 이 파일을 프로젝트 루트에 .env 로 복사한 뒤 값 확인
#   cp .env.example .env
#
# [사전 준비 — 클론 직후 1회]
# 1. Cloudflare WARP 앱 설치 → Zero Trust 로그인 (팀 이름: example)
#    - 등록된 이메일 계정이 필요하며 빌드/실행 중에는 WARP 연결을 유지한다.
#    - 내부 서비스도 .com 이름을 사용하지만, WARP 연결 중에는 Cloudflare Private
#      Hostname Route를 통해 Kubernetes 내부 서비스로 연결된다.
#
# 2. 이 파일을 프로젝트 루트의 .env로 복사하고 전달받은 비밀값을 입력한다.
#    .env는 gitignore 대상이며 Git에 커밋하지 않는다.
#
# 3. 전달받은 Vault 부트스트랩 파일을 다음 경로에 배치한다.
#      coderhan/bootstrap/certificate.crt
#      coderhan/bootstrap/private.key
#    이 파일은 OS 인증서 저장소에 설치하지 않는다. 애플리케이션이 mTLS 로그인에만 사용한다.
#    coderhan/ 디렉토리는 gitignore 대상이며 절대 커밋하지 않는다.
#
# 4. 로컬 HTTPS 인증서는 개발자 PC마다 mkcert로 직접 만든다.
#    다른 개발자의 mkcert 루트 개인키나 localhost 개인키를 공유하지 않는다.
#    Windows PowerShell 예시:
#      mkcert -install
#      New-Item -ItemType Directory -Force .\frontend\certificates
#      mkcert -cert-file .\frontend\certificates\localhost.pem `
#        -key-file .\frontend\certificates\localhost-key.pem `
#        localhost localhost.example.com 127.0.0.1 ::1
#
# [별도 설치가 필요 없는 인증서]
# - Nexus는 공인 인증서를 사용하므로 JDK cacerts 수정이 필요 없다.
# - Vault 서버 CA, Kafka 서버 CA, CockroachDB 서버 CA는
#   example-vault-cert 라이브러리가 애플리케이션 메모리에서 처리한다.
# ============================================================

SERVER_PORT=8080
DEV_SSL_CERTIFICATE=file:./frontend/certificates/localhost.pem
DEV_SSL_PRIVATE_KEY=file:./frontend/certificates/localhost-key.pem
SPRING_APPLICATION_NAME=last-mission-backend

# --- DB (CockroachDB — WARP Private Hostname Route + Vault mTLS) ---
# 비밀번호 대신 Vault가 메모리에서 발급한 DB 클라이언트 인증서를 사용한다.
DB_URL=jdbc:postgresql://cockroach-db.example.com:26257/lastmission?sslmode=verify-full
DB_USERNAME=lastmission_svc_main
DB_PASSWORD=
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
DB_HIKARI_INITIALIZATION_FAIL_TIMEOUT=-1

# --- JPA (스키마는 수동 관리 — ddl-auto 켜지 말 것) ---
JPA_DDL_AUTO=none
JPA_DATABASE_PLATFORM=org.hibernate.dialect.CockroachDialect
JPA_OPEN_IN_VIEW=false

# --- Kafka (WARP Private Hostname Route + Vault mTLS) ---
# bootstrap 접속 후 Kafka가 kafka-broker-0.example.com:9094를 광고한다.
# 로컬에서 Kafka가 필요하지 않으면 LASTMISSION_KAFKA_ENABLED=false로 설정한다.
KAFKA_BOOTSTRAP_SERVERS=kafka-bootstrap.example.com:9094
LASTMISSION_KAFKA_ENABLED=true
LASTMISSION_KAFKA_TOPIC=lastmission.main.events
# Consumer Group은 미리 생성하지 않는다. 새 group.id로 처음 접속하면 Kafka가 자동 생성한다.
# 같은 그룹의 인스턴스들은 메시지를 분담하므로 운영 그룹 lastmission-main을 로컬에서 사용하지 않는다.
# 각 개발자는 lastmission-main-dev- 뒤의 값을 본인의 고유한 영문 ID로 변경한다.
# 허용되는 개발 그룹 이름은 lastmission-main-dev-* 이다.
LASTMISSION_KAFKA_CONSUMER_GROUP=lastmission-main-dev-CHANGE_ME

# --- Valkey / Redis (local development through Cloudflare WARP) ---
SPRING_DATA_REDIS_HOST=valkey.example.com
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false

# --- Google Meet (참가 기록 집계 — 로컬 개발은 비워두면 비활성, 링크 버튼만 동작) ---
LASTMISSION_MEET_URL=https://meet.google.com/hng-rzcs-dkq
LASTMISSION_MEET_SYNC_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Vault (부트스트랩 인증서 필요 — 상단 [사전 준비] 3번) ---
VAULT_DB_COMMON_NAME=lastmission_svc_main
VAULT_KAFKA_COMMON_NAME=lastmission-svc-main
VAULT_BOOTSTRAP_DIR=coderhan/bootstrap
VAULT_LOG_DIR=coderhan/logs
VAULT_AUTH_MOUNT=cert-lastmission
VAULT_URI=https://vault.example.com:8200
VAULT_AUTHENTICATION=CERT
VAULT_AUTH_ROLE=cert-lastmission-main
VAULT_DB_PKI_PATH=pki_lastmission_crdb/sign/crdb-lastmission-svc-main-client
VAULT_KAFKA_PKI_PATH=pki_lastmission_kafka/sign/kafka-lastmission-svc-main-client

# --- 중앙 인증 (auth-core) ---
# login/logout은 브라우저용이라 반드시 .com (쿠키 Domain=example.com 이 여기서 설정됨)
# check는 서버-투-서버 — 로컬 PC에서는 .com 그대로 두는 게 단순 (쿠버 배포만 .internal 사용)
AUTH_PROJECT_ID=lastmission
AUTH_APP_ID=lastmission
AUTH_CHECK_URL=https://auth.example.com/auth/check
AUTH_LOGIN_URL=https://auth.example.com/auth/login
AUTH_LOGOUT_URL=https://auth.example.com/auth/logout

# 로그인/로그아웃 후 복귀 주소 — 로컬 개발은 반드시 로컬 프론트 주소로!
# (운영 주소를 넣으면 로컬에서 로그인 후 운영 사이트로 이동해버림)
# ※ localhost:3000이 아니라 localhost.example.com인 이유:
#    세션 쿠키(Domain=example.com)는 example.com 계열 + HTTPS에서만 전달됨.
#    localhost.example.com은 공용 DNS가 127.0.0.1로 풀어주는 개발용 도메인 (hosts 설정 불필요)
POST_LOGIN_REDIRECT=https://localhost.example.com:3000/
POST_LOGOUT_REDIRECT=https://localhost.example.com:3000/
